---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import ProjectCard from '@/components/project-card.astro'
import { badgeVariants } from '@/components/ui/badge'
import { buttonVariants } from '@/components/ui/button'
import PaginationComponent from '@/components/ui/pagination'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { getAllProjects, groupProjectsByYear } from '@/lib/data-utils'
import { cn } from '@/lib/utils'
import type { PaginateFunction } from 'astro'
import { Icon } from 'astro-icon/components'

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const allProjects = await getAllProjects()
  return paginate(allProjects, { pageSize: SITE.postsPerPage })
}

const { page } = Astro.props
const allProjects = await getAllProjects()
const projectsCount = allProjects.length

const projectsByYear = groupProjectsByYear(page.data)
const years = Object.keys(projectsByYear).sort((a, b) => {
  if (a === 'Undated') return 1
  if (b === 'Undated') return -1
  return parseInt(b) - parseInt(a)
})
---

<Layout class="max-w-3xl">
  <PageHead
    slot="head"
    title="Projects"
    description="A collection of my projects."
  />
  <Breadcrumbs
    items={[
      { label: 'Projects', href: '/projects', icon: 'lucide:folder-kanban' },
      { label: `Page ${page.currentPage}`, icon: 'lucide:book-copy' },
    ]}
  />

  <div class="flex min-h-[calc(100vh-18rem)] flex-col gap-y-8">
    <div class="mb-3 flex items-center gap-2 text-sm font-medium">
      <Icon name="lucide:folder-kanban" class="size-4" />
      Projects
      <span class={badgeVariants({ variant: 'muted' })}>{projectsCount}</span>
    </div>
    {
      projectsCount > 0 ? (
        years.map((year) => (
          <section class="flex flex-col gap-y-4">
            <div class="font-medium">{year}</div>
            <ul class="flex flex-col gap-4">
              {projectsByYear[year].map((project) => (
                <li>
                  <ProjectCard project={project} />
                </li>
              ))}
            </ul>
          </section>
        ))
      ) : (
        <section
          data-pagefind-ignore
          class="flex flex-col items-center justify-center gap-y-4 text-center"
        >
          <p class="prose max-w-md">No projects yet. Check back soon!</p>
          <Link
            href="/"
            class={cn(
              buttonVariants({ variant: 'outline' }),
              'group flex gap-x-1.5',
            )}
          >
            <span class="transition-transform group-hover:-translate-x-1">
              &larr;
            </span>
            Go to home page
          </Link>
        </section>
      )
    }
  </div>

  {
    projectsCount > 0 && (
      <PaginationComponent
        currentPage={page.currentPage}
        totalPages={page.lastPage}
        baseUrl="/projects/"
        client:load
      />
    )
  }
</Layout>
